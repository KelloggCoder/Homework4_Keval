<h1 class="mb-3">Places</h1>

<ul class="list-group mb-4">
  <% for place in @places %>
    <li class="list-group-item">
      <a href="/places/<%= place["id"] %>"><%= place["name"] %></a>
    </li>
  <% end %>
</ul>

<%# btn btn-primary = solid blue button. btn-success = green, btn-danger = red, btn-secondary = grey %>
<a href="/places/new" class="btn btn-primary">New Place</a>